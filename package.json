{
  "name": "tabletennisdb",
  "version": "1.0.1",
  "description": "TableTennisDB looks up rankings and event information on ITTF and equipment ratings on RevSpin.",
  "main": "src/bot.ts",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "bun run --bun src/bot.ts",
    "deploy": "bun run --bun scripts/deploy-commands.ts",
    "clear": "bun run --bun scripts/deploy-commands.ts --clear",
    "validate": "bun run --bun scripts/validate-env.ts"
  },
  "author": "Zack Rauen",
  "license": "MIT",
  "devDependencies": {
    "@types/string-similarity": "^4.0.2",
    "@zerebos/eslint-config": "file:../../eslint-configs/packages/base",
    "@zerebos/eslint-config-typescript": "file:../../eslint-configs/packages/typescript",
    "eslint": "^9.29.0"
  },
  "dependencies": {
    "@discordjs/core": "^2.1.0",
    "@discordjs/rest": "^2.5.0",
    "@keyv/sqlite": "^4.0.4",
    "canvas": "^3.1.0",
    "cheerio": "^1.1.0",
    "discord.js": "^14.19.3",
    "dotenv": "^16.5.0",
    "keyv": "^5.3.4",
    "string-similarity": "^4.0.4"
  },
  "overrides": {
    "sqlite3": {
      "prebuild-install": "7.1.3"
    },
    "canvas": {
      "prebuild-install": "7.1.3"
